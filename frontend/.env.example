# Frontend environment (Vite)
# Copy values into Vercel Project → Settings → Environment Variables
# Local `npm run dev` works without this file (defaults to localhost).

# Public Express API URL (no trailing slash)
# Local default: http://localhost:4000
VITE_API_URL=

# Public CCTV MJPEG / events server URL (no trailing slash)
# Local default: http://localhost:8000
# Later (online CCTV): https://your-tunnel.ngrok-free.app
VITE_STREAM_URL=
