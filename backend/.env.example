# Backend environment (copy to `.env` — do not commit secrets)

JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (Vercel / custom domain)
# Example: https://poolseye.vercel.app,https://www.yourdomain.com
FRONTEND_ORIGIN=

# Optional — Brevo email API (leave empty for console/demo codes)
BREVO_API_KEY=
BREVO_SENDER=PoolsEye <noreply@yourdomain.com>

# Optional — shared secret for live_server.py event ingest
EVENTS_INGEST_SECRET=
